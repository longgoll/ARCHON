{
  "name": "eslint-plugin-archon",
  "version": "0.1.0",
  "description": "ESLint plugin for Archon - Deterministic Architectural Guardrails for AI-assisted engineering",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "tsx --test test/**/*.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@archon/core": "workspace:*"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.13.1",
    "eslint": "^9.20.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  }
}
