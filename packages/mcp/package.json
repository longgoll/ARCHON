{
  "name": "@archon/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for Archon - real-time architectural guardrails & context retrieval for AI Agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "archon-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "tsx --test test/mcp.test.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@archon/core": "workspace:*",
    "@archon/skeleton": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "rimraf": "^6.0.1"
  }
}
